{
  "name": "@tahweel/server",
  "version": "0.1.0",
  "private": true,
  "description": "Tahweel server: ingests wallet SMS from the listener phone, matches receipts to payment intents, fires signed webhooks.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-samples.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate-cli.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "hono": "^4.10.7",
    "jose": "^6.1.3",
    "kysely": "^0.28.9",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
