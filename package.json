{
  "name": "tahweel",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a spare Android phone into a self-hosted payment gateway for mobile wallets: the phone forwards wallet SMS receipts, the server matches them to payment intents and fires signed webhooks.",
  "license": "MIT",
  "author": "Ashraf Eldawody",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* run build",
    "test": "pnpm -r --filter ./packages/* run test",
    "dev:server": "pnpm --filter @tahweel/server dev",
    "dev:ui": "pnpm --filter @tahweel/ui dev",
    "openapi": "pnpm --filter @tahweel/server run openapi:export",
    "postman": "node scripts/generate-postman.mjs",
    "build:listener": "powershell -ExecutionPolicy Bypass -File scripts/build-listener.ps1"
  }
}
