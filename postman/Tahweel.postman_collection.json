              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": [],
              "variable": []
            },
            "description": "Liveness and database check"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Ingest (phone)",
      "description": "Called by the Tahweel Listener Android app",
      "item": [
        {
          "name": "Forward a batch of SMS from the listener phone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ingestToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "sms"
              ],
              "query": [],
              "variable": []
            },
            "description": "Forward a batch of SMS from the listener phone\n\nIdempotent. The phone forwards every SMS; the server classifies each one (receipt or not, trusted sender, age) and tries to match receipts to pending payment intents. Duplicate fingerprints are accepted but not re-inserted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"sm-m526b-1a2b3c\",\n  \"messages\": [\n    {\n      \"fingerprint\": \"3b1c9d0f5e6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c\",\n      \"address\": \"e& money\",\n      \"body\": \"تم إستلام مبلغ 200.00 ج.م من رقم 01061916846 المسجل باسمABANWB N ASRAAEYL بنجاح. رصيد محفظتك الحالى 429.90 ج.م.\",\n      \"received_at\": \"2026-09-13T10:15:30.000Z\",\n      \"sim_slot\": 0\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Device heartbeat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ingestToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest/heartbeat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "heartbeat"
              ],
              "query": [],
              "variable": []
            },
            "description": "Device heartbeat\n\nSent every 60 s by the listener. Missing heartbeats past the offline threshold raise a device.offline event.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"sm-m526b-1a2b3c\",\n  \"name\": \"Samsung M52 office\",\n  \"app_version\": \"1.0.0\",\n  \"battery\": 87,\n  \"network\": \"wifi\",\n  \"pending_count\": 0,\n  \"last_sms_at\": \"2026-09-13T10:15:30.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payment intents (integrator API)",
      "description": "Create intents, poll their status, cancel them",
      "item": [
        {
          "name": "Create a payment intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "intents"
              ],
              "query": [],
              "variable": []
            },
            "description": "Create a payment intent\n\nTell Tahweel that you expect a wallet transfer. Matching requires sender_phone (recommended) or allow_amount_only=true (risky). If a matching receipt already arrived it is matched immediately and the response carries status=matched.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"order-1001\",\n  \"amount\": 200,\n  \"currency\": \"EGP\",\n  \"sender_phone\": \"01061916846\",\n  \"allow_amount_only\": false,\n  \"expires_in_minutes\": 120,\n  \"metadata\": {\n    \"order_id\": \"A-1001\",\n    \"customer\": \"Ahmed\"\n  },\n  \"webhook_url\": \"https://shop.example.com/webhooks/tahweel\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"intentId\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
